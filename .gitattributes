# Both people append to the log at the same time; union keeps both sides instead of conflicting.
PROGRESS_LOG.md merge=union
* text=auto eol=lf
*.png binary
*.jpg binary
*.glb binary
*.ogg binary
*.mp3 binary
*.wav binary
*.wasm binary
# Prebuilt sim (packages/sim-wasm/build.sh); the inlined base64 is one huge line.
packages/sim-wasm/pkg/** linguist-generated=true
packages/sim-wasm/pkg/sim_inline.js -diff
