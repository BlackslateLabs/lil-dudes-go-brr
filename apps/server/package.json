{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Matchmaking (room codes, quick-match queue), the burner faucet and the online bot for live matches. Never decides game outcomes.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@lil-dudes/client": "workspace:*",
    "@lil-dudes/sim-wasm": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "hono": "4.13.19",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
