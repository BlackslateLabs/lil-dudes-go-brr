  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
