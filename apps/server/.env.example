# Copy to apps/server/.env (gitignored) and fill in. Never commit a key.
PORT=8787
# Devnet only: the faucet checks the genesis hash and refuses any other cluster.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Sponsor wallet that tops up burners (MVP §8). Either a path to a Solana keypair file kept OUTSIDE
# the repo (e.g. ~/.config/lil-dudes/sponsor.json) ...
SPONSOR_KEYPAIR_PATH=
# ... or the key itself (64-byte JSON array or base58), for hosts where files are awkward.
# Set it in the host's secret store, not in a committed file.
SPONSOR_SECRET_KEY=
# 1 behind Render/Fly's proxy: per-IP limits use X-Forwarded-For.
TRUST_PROXY=0
# Base-layer RPC for the online bot's match calls (default: MagicBlock's devnet RPC).
BASE_RPC_URL=https://rpc.magicblock.app/devnet
# The online bot (free Quick Match after ~5 s alone) runs when the sponsor is set; BOT=0 turns it off.
BOT=1
# The bot's own wallet (= its burner). Optional: without it a fresh key is made per start, and its
# small float (~0.04 SOL per live bot match) is stranded on restart. Same formats as the sponsor.
BOT_KEYPAIR_PATH=
BOT_SECRET_KEY=
# The sweeper (every minute: refunds abandoned matches, settles late ones, closes paid-out ones;
# all permissionless) signs with the sponsor. SWEEP=0 turns it off.
SWEEP=1
# Match history file (JSON lines, public data only; append-safe, loaded on start). Empty = in
# memory only (a restart forgets it). On Render, point it at a persistent disk, e.g. /data/history.jsonl.
HISTORY_FILE=
# Allowed web origins, comma separated (e.g. https://lildudes.vercel.app). Empty = local dev origins
# only (localhost, 127.0.0.1, LAN IPs). '*' = any origin (dev only).
CORS_ORIGINS=
# Accounts and match history in Postgres (Neon: the pooled connection string, with
# sslmode=require). Empty = in memory (plus HISTORY_FILE). Set it in the host's secret store.
DATABASE_URL=
