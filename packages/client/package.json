{
  "name": "@lil-dudes/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The contract between the game client and the chain: MatchView, events, constants, MatchSource (mock / offline / live).",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke-offline.ts",
    "live": "tsx scripts/live-bot-match.ts",
    "idl": "cp ../../target/idl/lil_dudes.json src/idl/lil_dudes.json"
  },
  "dependencies": {
    "@lil-dudes/sim-wasm": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "@wallet-standard/app": "1.1.0",
    "@wallet-standard/base": "1.1.0",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
